# Hardened sandbox for the aitana Slack bot (aitana-bot), whose agent writes
# and runs its own Python. Guardrails baked into the image (see
# scripts/run_bot_sandboxed.sh for the capability/resource limits applied
# at `docker run` time):
#   - the bot runs as a non-root user, created at build time with UID/GID
#     matching the current user
#   - all outbound traffic from that user is forced through a local
#     allowlisting proxy started by init-firewall.sh and enforced with
#     iptables -- the bot user has no direct network access at all
#   - the aitana workspace and its virtualenv are owned by root, so the
#     agent can run the code and read the skills but not change them
ARG D_UID="1001"
ARG D_GID="1001"

FROM debian:bookworm-slim

ARG D_UID
ARG D_GID

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iptables tinyproxy \
 && rm -rf /var/lib/apt/lists/*

# Python + uv. The workspace pins requires-python >=3.11,<3.13 (see uv.lock);
# bookworm's system python3 (3.11) satisfies that, so uv can use it directly
# instead of fetching its own interpreter build.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# The workspace, installed at build time: the container needs no package
# index at runtime. Each member is copied on its own because uv needs every
# workspace member's pyproject.toml to resolve the lock.
WORKDIR /opt/aitana
COPY pyproject.toml uv.lock ./
COPY skills ./skills
COPY aitana-access ./aitana-access
COPY aitana-anomaly ./aitana-anomaly
COPY aitana-bot ./aitana-bot
COPY aitana-features ./aitana-features
COPY aitana-pipelines ./aitana-pipelines
COPY aitana-storage ./aitana-storage
COPY aitana-testing ./aitana-testing
COPY aitana-volcanoes ./aitana-volcanoes
RUN UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-dev --no-cache \
      --package aitana-bot --python /usr/bin/python3
ENV PATH="/opt/aitana/.venv/bin:${PATH}"

# proxyuser: the only account allowed to reach the network directly. It
# runs tinyproxy and enforces the domain allowlist (see init-firewall.sh);
# nothing else uses this account.
RUN groupadd -g 2000 proxyuser && \
    useradd -u 2000 -g 2000 -M -s /usr/sbin/nologin proxyuser

RUN groupadd -g "$D_GID" bot && \
    useradd -m -u "$D_UID" -g "$D_GID" -s /bin/bash bot

COPY docker/init-firewall.sh /usr/local/sbin/init-firewall.sh
COPY docker/entrypoint.sh /usr/local/sbin/entrypoint.sh
RUN chmod 750 /usr/local/sbin/init-firewall.sh /usr/local/sbin/entrypoint.sh

WORKDIR /home/bot

ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
