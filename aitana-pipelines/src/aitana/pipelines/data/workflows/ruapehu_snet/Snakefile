"""
Scattering-network coefficients of three-component Ruapehu seismic data.

Computes first- and second-order scattering coefficients of ``seed_id`` from
GeoNet waveforms with ``aitana.anomaly.snet.SNet`` (20-min windows every 10 min,
each labelled by its first sample), one job per UTC day so that completed days
are reused across runs, and stores them in aitana-storage. A run covers the last
``lookback_hours`` before ``end``.

With ``start`` set, e.g. ``--config start=2022-01-01``, the first run builds the
archive instead: it covers every day since ``start`` and writes to
``results/archive_<start>/``. Later runs find that directory and cover only the
last ``lookback_hours``; delete it to rebuild, e.g. after an outage longer than
``lookback_hours``, whose days no later run covers.

It also stores a two-dimensional embedding of each window's coefficients
(FastICA, then UMAP), fitted once on the days from ``fit_start`` to ``fit_end``,
and a novelty index with its alarm series, scored against the days from
``novelty_start`` to ``novelty_end``. The first run therefore computes the
reference days too.

Rules run in the active Python environment, which must provide aitana-access,
aitana-features, aitana-storage and aitana-anomaly (``uv sync`` in the aitana
workspace). Override config values on the command line, e.g.
``aitana-pipelines run ruapehu OUT --workflow ruapehu_snet --config end=2022-03-20T00:00``.
"""

import os

import pandas as pd


configfile: "config.yaml"


STEP = pd.Timedelta("10min")  # SNet's windows advance by 10 min
WINDOW = pd.Timedelta("20min")  # and span 20 min


def utc(value):
    ts = pd.Timestamp(value)
    return ts.tz_localize("UTC") if ts.tzinfo is None else ts.tz_convert("UTC")


def naive(ts):
    """ISO string in UTC without an offset, matching the SNet timestamps."""
    return ts.tz_convert(None).isoformat()


END = utc("now" if str(config["end"]) == "now" else str(config["end"])).floor(STEP)
START = END - pd.Timedelta(hours=config["lookback_hours"])
TAG = END.strftime("%Y%m%dT%H%M")
RESULTS = f"results/{TAG}"
OUTPUTS = ["stored", "embedding.csv", "novelty.csv"]
# Each rule writes its output last, so all three files mean the archive is stored.
if config["start"]:
    ARCHIVE_START = utc(str(config["start"]))
    ARCHIVE = f"results/archive_{ARCHIVE_START:%Y%m%d}"
    if not all(os.path.exists(f"{ARCHIVE}/{name}") for name in OUTPUTS):
        START = ARCHIVE_START
        RESULTS = ARCHIVE
# A day is complete once the window starting at 23:50 has ended, 10 min into the
# next day. The windows of the first incomplete day that have ended form the
# partial day.
PARTIAL_START = (END - WINDOW + STEP).floor("D")
# not inclusive="left": with equal ends it keeps the day
DAYS = pd.date_range(
    START.floor("D"), PARTIAL_START - pd.Timedelta(days=1), freq="D"
).strftime("%Y-%m-%d")
PARTIAL = [f"snet/partial_{TAG}.nc"] if END - PARTIAL_START >= WINDOW else []
FIT_DAYS = pd.date_range(
    str(config["fit_start"]), str(config["fit_end"]), freq="D", inclusive="left"
).strftime("%Y-%m-%d")
MODEL = f"model/embedding_{FIT_DAYS[0]}_{FIT_DAYS[-1]}.joblib"
NOVELTY_DAYS = pd.date_range(
    str(config["novelty_start"]), str(config["novelty_end"]), freq="D", inclusive="left"
).strftime("%Y-%m-%d")
NOVELTY_MODEL = f"model/novelty_{NOVELTY_DAYS[0]}_{NOVELTY_DAYS[-1]}.joblib"


wildcard_constraints:
    day=r"\d{4}-\d{2}-\d{2}",


rule all:
    input:
        expand("{results}/{name}", results=RESULTS, name=OUTPUTS),


# Coefficients of the windows starting on one complete UTC day, cached in
# snet/<day>.nc: later runs reuse the file. Delete it to fetch and recompute that
# day, e.g. after a data gap is filled; a day older than lookback_hours needs the
# archive deleted too, as only building the archive covers it.
rule snet_day:
    output:
        "snet/{day}.nc",
    params:
        start=lambda wc: pd.Timestamp(wc.day).isoformat(),
        end=lambda wc: (pd.Timestamp(wc.day) + pd.Timedelta(days=1) + WINDOW - STEP).isoformat(),
    script:
        "scripts/snet.py"


# The incomplete day, recomputed for every new end time.
rule snet_partial:
    output:
        temp(f"snet/partial_{TAG}.nc"),
    params:
        start=naive(PARTIAL_START),
        end=naive(END),
    script:
        "scripts/snet.py"


rule store:
    input:
        expand("snet/{day}.nc", day=DAYS) + PARTIAL,
    output:
        touch(f"{RESULTS}/stored"),
    script:
        "scripts/store.py"


# The embedding and the novelty detector are fitted once on their reference days
# and cached in model/, named by the reference period: later runs reuse them, a
# new reference period refits.
rule fit_embedding:
    input:
        expand("snet/{day}.nc", day=FIT_DAYS),
    output:
        MODEL,
    script:
        "scripts/fit_embedding.py"


rule embed:
    input:
        snet=expand("snet/{day}.nc", day=DAYS) + PARTIAL,
        model=MODEL,
    output:
        f"{RESULTS}/embedding.csv",
    script:
        "scripts/embed.py"


rule fit_novelty:
    input:
        expand("snet/{day}.nc", day=NOVELTY_DAYS),
    output:
        NOVELTY_MODEL,
    script:
        "scripts/fit_novelty.py"


rule novelty:
    input:
        snet=expand("snet/{day}.nc", day=DAYS) + PARTIAL,
        model=NOVELTY_MODEL,
    output:
        f"{RESULTS}/novelty.csv",
    script:
        "scripts/novelty.py"
